# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
env/
venv/
ENV/

# Environment variables & secrets
.env
.env.local
.env.*.local
!.env.example

# Data Science directory data files (keep folder hierarchy via .gitkeep)
data/01_raw/*
!data/01_raw/.gitkeep
data/02_interim/*
!data/02_interim/.gitkeep
data/03_processed/*
!data/03_processed/.gitkeep
data/04_external/*
!data/04_external/.gitkeep

# Serialized models and large weights
models/*
!models/.gitkeep
*.joblib
*.pkl
*.pickle
*.h5
*.onnx
*.pt
*.pth
*.ckpt
*.safetensors

# Generated figures and reports
reports/figures/*
!reports/figures/.gitkeep

# Jupyter Notebook checkpoints and autosaves
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.coverage.*

# Linters, Type Checkers & Tool Caches
.ruff_cache/
.mypy_cache/
.pyright/

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db

# IDEs (VS Code settings are versioned in .vscode/settings.json)
.idea/
*.swp
*.swo
*~
